<!DOCTYPE html>
<html lang="en" data-theme="" class=""><head>
<meta http-equiv="content-type" content="text/html; charset=UTF-8">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Long Road to War — History Quiz</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link href="The%20Long%20Road%20to%20War%20%E2%80%94%20History%20Quiz_files/css2.css" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════
   THEME VARIABLES (identical to timeline)
══════════════════════════════════════════════ */
:root {
  --bg:           #0e0c09;
  --surface:      #16130e;
  --surface2:     #1e1a13;
  --border:       #3a3020;
  --border-light: #52472e;
  --ink:          #e8dfc8;
  --ink-dim:      #9e9278;
  --ink-faint:    #5c5240;
  --accent:       #c8973a;
  --accent-dim:   #8a6425;
  --accent-glow:  rgba(200,151,58,0.15);
  --red:          #c0392b;
  --green:        #2e7d4f;
  --blue:         #2e6da4;
  --font-display: 'Playfair Display', Georgia, serif;
  --font-body:    'EB Garamond', Georgia, serif;
  --font-mono:    'Courier Prime', 'Courier New', monospace;
}
[data-theme="ivory"] {
  --bg:#f5f0e8;--surface:#ede7d9;--surface2:#e3dccf;--border:#c8bfa8;
  --border-light:#a89880;--ink:#1e1810;--ink-dim:#5a4e3c;--ink-faint:#9e8e78;
  --accent:#8b2c1a;--accent-dim:#6b1e10;--accent-glow:rgba(139,44,26,0.12);
}
[data-theme="midnight"] {
  --bg:#080e1a;--surface:#0d1624;--surface2:#121d2e;--border:#1e3050;
  --border-light:#2a4268;--ink:#ccdcf0;--ink-dim:#7a9cc0;--ink-faint:#3a5878;
  --accent:#4a9edd;--accent-dim:#2e7ab8;--accent-glow:rgba(74,158,221,0.15);
}
[data-theme="sepia"] {
  --bg:#2a1f0e;--surface:#342710;--surface2:#3e2f15;--border:#5c4422;
  --border-light:#7a5c2e;--ink:#f0ddb0;--ink-dim:#b09060;--ink-faint:#6e5030;
  --accent:#e8a030;--accent-dim:#c07818;--accent-glow:rgba(232,160,48,0.15);
}
[data-theme="slate"] {
  --bg:#111418;--surface:#191d22;--surface2:#20252c;--border:#2e3540;
  --border-light:#3e4a58;--ink:#d4dce8;--ink-dim:#7a8898;--ink-faint:#404c5a;
  --accent:#7eb8d4;--accent-dim:#5a9ab8;--accent-glow:rgba(126,184,212,0.12);
}
[data-theme="verdun"] {
  --bg:#0a0f09;--surface:#111710;--surface2:#181f16;--border:#2a3828;
  --border-light:#3c5038;--ink:#d4e0c8;--ink-dim:#7a9870;--ink-faint:#3c5038;
  --accent:#7ab848;--accent-dim:#5a9030;--accent-glow:rgba(122,184,72,0.13);
}
[data-theme="crimson"] {
  --bg:#100608;--surface:#1a090c;--surface2:#220c10;--border:#3a1018;
  --border-light:#581828;--ink:#f0d8d4;--ink-dim:#b08080;--ink-faint:#5c3030;
  --accent:#e04040;--accent-dim:#b82020;--accent-glow:rgba(224,64,64,0.15);
}

*,*::before,*::after { box-sizing:border-box;margin:0;padding:0; }
html { scroll-behavior:smooth; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── TOP BAR ── */
#topbar {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0 24px;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  position: sticky;
  top: 0;
  z-index: 100;
}
.topbar-logo {
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.topbar-kicker {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 3px;
  color: var(--accent);
  text-transform: uppercase;
}
.topbar-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 900;
  color: var(--ink);
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Theme swatches */
.theme-swatch {
  width: 18px; height: 18px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.15s;
  flex-shrink: 0;
}
.theme-swatch:hover { transform: scale(1.2); }
.theme-swatch.active { border-color: var(--ink); }
.theme-swatches { display: flex; gap: 6px; align-items: center; }

/* ── MAIN ── */
#main {
  flex: 1;
  display: flex;
  align-items: stretch;
  justify-content: center;
  padding: 40px 24px 60px;
}
.game-container {
  width: 100%;
  max-width: 820px;
}

/* ── SPLASH SCREEN ── */
#screen-splash {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 140px);
  text-align: center;
  gap: 0;
}
.splash-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 16px;
}
.splash-title {
  font-family: var(--font-display);
  font-size: clamp(36px, 6vw, 64px);
  font-weight: 900;
  line-height: 1.1;
  color: var(--ink);
  margin-bottom: 8px;
}
.splash-subtitle {
  font-family: var(--font-display);
  font-size: clamp(16px, 2.5vw, 22px);
  font-style: italic;
  color: var(--accent);
  margin-bottom: 32px;
}
.splash-desc {
  font-size: 17px;
  color: var(--ink-dim);
  max-width: 480px;
  line-height: 1.7;
  margin-bottom: 48px;
}
.splash-meta {
  display: flex;
  gap: 32px;
  justify-content: center;
  margin-bottom: 48px;
}
.splash-stat {
  text-align: center;
}
.splash-stat-num {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: 900;
  color: var(--accent);
  display: block;
}
.splash-stat-lbl {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--ink-faint);
  text-transform: uppercase;
  display: block;
  margin-top: 4px;
}

/* Difficulty selection */
.difficulty-row {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-bottom: 32px;
  flex-wrap: wrap;
}
.diff-btn {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 10px 22px;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  background: var(--surface);
  color: var(--ink-dim);
  cursor: pointer;
  transition: all 0.2s;
}
.diff-btn:hover { background: var(--surface2); color: var(--ink); border-color: var(--accent-dim); }
.diff-btn.selected { background: var(--surface2); color: var(--accent); border-color: var(--accent); }

.start-btn {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  padding: 16px 56px;
  background: var(--accent);
  color: var(--bg);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: filter 0.2s, transform 0.15s;
  letter-spacing: 0.5px;
}
.start-btn:hover { filter: brightness(1.12); transform: translateY(-2px); }
.start-btn:active { transform: translateY(0); }

/* ── GAME HEADER (progress + timer) ── */
#screen-game, #screen-result {
  display: none;
  width: 100%;
}
#screen-game.active, #screen-result.active {
  display: block;
}
#screen-splash.active { display: flex; }

.game-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}
.progress-wrap {
  flex: 1;
  height: 5px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: var(--accent);
  border-radius: 3px;
  transition: width 0.4s ease;
}
.question-num {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--ink-faint);
  white-space: nowrap;
  min-width: 80px;
  text-align: right;
}
.score-live {
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--accent);
  white-space: nowrap;
  min-width: 60px;
  text-align: right;
}

/* ── TIMER ── */
.timer-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28px;
}
.timer-ring {
  width: 80px;
  height: 80px;
  position: relative;
  flex-shrink: 0;
}
.timer-ring svg {
  transform: rotate(-90deg);
  width: 80px;
  height: 80px;
}
.timer-ring .ring-bg {
  fill: none;
  stroke: var(--border);
  stroke-width: 4;
}
.timer-ring .ring-progress {
  fill: none;
  stroke: var(--accent);
  stroke-width: 4;
  stroke-linecap: round;
  stroke-dasharray: 220;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 1s linear, stroke 0.3s;
}
.timer-ring.warning .ring-progress { stroke: #e87020; }
.timer-ring.critical .ring-progress { stroke: var(--red); }
.timer-num {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 900;
  color: var(--ink);
  transition: color 0.3s;
}
.timer-ring.critical .timer-num { color: var(--red); }

.timer-bar-wrap {
  flex: 1;
  height: 8px;
  background: var(--border);
  border-radius: 4px;
  overflow: hidden;
  margin: 0 16px;
}
.timer-bar {
  height: 100%;
  background: var(--accent);
  border-radius: 4px;
  transition: width 1s linear, background 0.3s;
  width: 100%;
}
.timer-bar.warning { background: #e87020; }
.timer-bar.critical { background: var(--red); }

/* ── QUESTION CARD ── */
.question-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 32px 36px;
  margin-bottom: 24px;
  position: relative;
  overflow: hidden;
}
.question-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 4px;
  height: 100%;
  background: var(--accent);
}
.question-category {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 2.5px;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.q-cat-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}
.question-text {
  font-family: var(--font-display);
  font-size: clamp(18px, 3vw, 26px);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  margin-bottom: 10px;
}
.question-context {
  font-size: 14px;
  color: var(--ink-dim);
  line-height: 1.6;
  font-style: italic;
}

/* ── ANSWER OPTIONS ── */
.answers-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 20px;
}
@media (max-width: 580px) {
  .answers-grid { grid-template-columns: 1fr; }
}

.answer-btn {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 18px 20px;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--ink);
  transition: all 0.18s;
  position: relative;
  overflow: hidden;
  min-height: 68px;
}
.answer-btn:hover:not(:disabled) {
  background: var(--surface2);
  border-color: var(--accent-dim);
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(0,0,0,0.25);
}
.answer-btn:active:not(:disabled) { transform: translateY(0); }

.answer-letter {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
  background: var(--surface2);
  border: 1px solid var(--border-light);
  border-radius: 3px;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.18s;
}
.answer-btn:hover:not(:disabled) .answer-letter {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}
.answer-text {
  flex: 1;
  line-height: 1.4;
  padding-top: 2px;
}

/* Answer states */
.answer-btn.correct {
  background: rgba(46,125,79,0.18);
  border-color: var(--green);
  color: var(--ink);
}
.answer-btn.correct .answer-letter {
  background: var(--green);
  color: white;
  border-color: var(--green);
}
.answer-btn.wrong {
  background: rgba(192,57,43,0.15);
  border-color: var(--red);
  color: var(--ink-dim);
}
.answer-btn.wrong .answer-letter {
  background: var(--red);
  color: white;
  border-color: var(--red);
}
.answer-btn.reveal-correct {
  background: rgba(46,125,79,0.12);
  border-color: var(--green);
}
.answer-btn.reveal-correct .answer-letter {
  background: var(--green);
  color: white;
  border-color: var(--green);
}
.answer-btn:disabled { cursor: default; transform: none !important; }

/* Result pill after answering */
.result-pill {
  text-align: center;
  margin-bottom: 20px;
  min-height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}
.result-correct {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: var(--green);
}
.result-wrong {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: var(--red);
}
.result-timeout {
  font-family: var(--font-display);
  font-size: 18px;
  font-style: italic;
  color: var(--ink-dim);
}
.points-pill {
  font-family: var(--font-mono);
  font-size: 13px;
  background: var(--surface2);
  border: 1px solid var(--border-light);
  border-radius: 20px;
  padding: 3px 14px;
  color: var(--accent);
}

/* Explanation */
.explanation {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: 0 6px 6px 0;
  padding: 14px 18px;
  font-size: 14px;
  color: var(--ink-dim);
  line-height: 1.65;
  margin-bottom: 20px;
  display: none;
}
.explanation.show { display: block; }
.explanation strong { color: var(--ink); }

/* Next button */
.next-btn {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 700;
  padding: 13px 44px;
  background: var(--accent);
  color: var(--bg);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: filter 0.2s, transform 0.15s;
  display: block;
  margin: 0 auto;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s, filter 0.2s, transform 0.15s;
}
.next-btn.show { opacity: 1; pointer-events: auto; }
.next-btn:hover { filter: brightness(1.12); transform: translateY(-2px); }

/* ── RESULTS SCREEN ── */
#screen-result {
  text-align: center;
  padding: 20px 0 60px;
}
.result-kicker {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 3px;
  color: var(--accent);
  text-transform: uppercase;
  margin-bottom: 14px;
}
.result-title {
  font-family: var(--font-display);
  font-size: clamp(28px, 5vw, 52px);
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 8px;
}
.result-subtitle {
  font-family: var(--font-display);
  font-size: 18px;
  font-style: italic;
  color: var(--accent);
  margin-bottom: 40px;
}
.result-score-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 40px 48px;
  display: inline-block;
  margin-bottom: 40px;
  min-width: 320px;
}
.result-score-big {
  font-family: var(--font-display);
  font-size: 80px;
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  display: block;
}
.result-score-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 2.5px;
  color: var(--ink-faint);
  text-transform: uppercase;
  display: block;
  margin-top: 8px;
  margin-bottom: 24px;
}
.result-stats {
  display: flex;
  gap: 24px;
  justify-content: center;
  flex-wrap: wrap;
}
.result-stat {
  text-align: center;
}
.result-stat-num {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  color: var(--ink);
  display: block;
}
.result-stat-lbl {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 1.5px;
  color: var(--ink-faint);
  text-transform: uppercase;
  display: block;
}
.result-rank {
  font-family: var(--font-display);
  font-size: 22px;
  font-style: italic;
  color: var(--ink-dim);
  margin-bottom: 40px;
}

/* Breakdown table */
.breakdown-wrap {
  max-width: 620px;
  margin: 0 auto 40px;
  text-align: left;
}
.breakdown-title {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 2.5px;
  color: var(--ink-faint);
  text-transform: uppercase;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
}
.breakdown-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.breakdown-icon {
  font-size: 16px;
  width: 22px;
  text-align: center;
  flex-shrink: 0;
}
.breakdown-q {
  flex: 1;
  color: var(--ink-dim);
  line-height: 1.3;
}
.breakdown-q strong { color: var(--ink); }
.breakdown-pts {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent);
  white-space: nowrap;
}

.result-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}
.btn-primary {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  padding: 14px 44px;
  background: var(--accent);
  color: var(--bg);
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: filter 0.2s, transform 0.15s;
}
.btn-primary:hover { filter: brightness(1.12); transform: translateY(-2px); }
.btn-secondary {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  padding: 14px 36px;
  background: none;
  color: var(--ink-dim);
  border: 1px solid var(--border-light);
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}
.btn-secondary:hover { background: var(--surface2); color: var(--ink); border-color: var(--accent-dim); }

/* Countdown intro */
.countdown-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.countdown-overlay.show { opacity: 1; pointer-events: auto; }
.countdown-num {
  font-family: var(--font-display);
  font-size: 160px;
  font-weight: 900;
  color: var(--accent);
  animation: countPop 0.8s ease;
  text-shadow: 0 0 60px var(--accent-glow);
}
@keyframes countPop {
  0% { transform: scale(1.4); opacity: 0; }
  30% { transform: scale(1); opacity: 1; }
  80% { transform: scale(1); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0; }
}

/* Score animation */
@keyframes scoreUp {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(-40px) scale(1.2); opacity: 0; }
}
.score-anim {
  position: fixed;
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 900;
  color: var(--green);
  pointer-events: none;
  animation: scoreUp 1.2s ease forwards;
  z-index: 500;
}

/* Decorative line */
.divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 28px 0;
}

/* Streak badge */
.streak-badge {
  display: inline-flex;
  align-items: center;
