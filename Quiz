/* ══════════════════════════════════════════════
   THEMES
══════════════════════════════════════════════ */
const THEMES = [
  { id:'obsidian', name:'Obsidian', bg:'#0e0c09', accent:'#c8973a' },
  { id:'ivory',    name:'Ivory',    bg:'#f5f0e8', accent:'#8b2c1a' },
  { id:'midnight', name:'Midnight', bg:'#080e1a', accent:'#4a9edd' },
  { id:'sepia',    name:'Sepia',    bg:'#2a1f0e', accent:'#e8a030' },
  { id:'slate',    name:'Slate',    bg:'#111418', accent:'#7eb8d4' },
  { id:'verdun',   name:'Verdun',   bg:'#0a0f09', accent:'#7ab848' },
  { id:'crimson',  name:'Crimson',  bg:'#100608', accent:'#e04040' },
];

let activeTheme = localStorage.getItem('quiz-theme') || 'obsidian';
function applyTheme(id) {
  activeTheme = id;
  document.documentElement.setAttribute('data-theme', id === 'obsidian' ? '' : id);
  localStorage.setItem('quiz-theme', id);
  document.querySelectorAll('.theme-swatch').forEach(s => s.classList.toggle('active', s.dataset.theme === id));
}

// Build theme swatches
const swatchWrap = document.getElementById('theme-swatches');
THEMES.forEach(t => {
  const s = document.createElement('div');
  s.className = 'theme-swatch' + (t.id === activeTheme ? ' active' : '');
  s.dataset.theme = t.id;
  s.style.background = t.bg;
  s.style.boxShadow = `0 0 0 2px ${t.accent}44`;
  s.title = t.name;
  s.addEventListener('click', () => applyTheme(t.id));
  swatchWrap.appendChild(s);
});
applyTheme(activeTheme);

/* ══════════════════════════════════════════════
   GAME STATE
══════════════════════════════════════════════ */
let gameQuestions = [];
let currentQ = 0;
let score = 0;
let streak = 0;
let bestStreak = 0;
let correctCount = 0;
let totalTime = 60;
let timeLeft = 60;
let timerInterval = null;
let answered = false;
let questionStartTime = 0;
let speedTimes = [];
let breakdown = [];
let difficulty = 'standard';

const CIRCUMFERENCE = 2 * Math.PI * 34; // 213.6

const $ = id => document.getElementById(id);

/* Shuffle array */
function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* ── DIFFICULTY ── */
document.querySelectorAll('.diff-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    difficulty = btn.dataset.diff;
    totalTime = difficulty === 'blitz' ? 30 : 60;
  });
});

/* ── START ── */
$('start-btn').addEventListener('click', () => {
  gameQuestions = shuffle(QUESTIONS).slice(0, 20);
  currentQ = 0; score = 0; streak = 0; bestStreak = 0;
  correctCount = 0; speedTimes = []; breakdown = [];
  totalTime = difficulty === 'blitz' ? 30 : 60;
  showCountdown();
});

function showCountdown() {
  const overlay = $('countdown-overlay');
  const numEl = $('countdown-num');
  overlay.classList.add('show');
  let count = 3;
  numEl.textContent = count;

  const interval = setInterval(() => {
    count--;
    if (count === 0) {
      numEl.textContent = 'Go!';
    } else if (count < 0) {
      clearInterval(interval);
      overlay.classList.remove('show');
      showScreen('game');
      loadQuestion();
    } else {
      numEl.textContent = count;
      // Re-trigger animation
      numEl.style.animation = 'none';
      numEl.offsetHeight; // reflow
      numEl.style.animation = '';
    }
  }, 900);
}

function showScreen(name) {
  document.querySelectorAll('#screen-splash,#screen-game,#screen-result').forEach(el => {
    el.classList.remove('active');
  });
  $('screen-' + name).classList.add('active');
}

/* ── LOAD QUESTION ── */
function loadQuestion() {
  answered = false;
  questionStartTime = Date.now();

  const q = gameQuestions[currentQ];
  const total = gameQuestions.length;

  // Progress
  $('progress-bar').style.width = ((currentQ / total) * 100) + '%';
  $('question-num').textContent = `${currentQ + 1} / ${total}`;
  $('score-live').textContent = score + ' pts';

  // Category
  $('category-text').textContent = q.category.charAt(0).toUpperCase() + q.category.slice(1);
  $('year-text').textContent = q.year;
  $('question-card').querySelector('.q-cat-dot').style.background = getCatColor(q.category);

  // Question text
  $('question-text').textContent = q.q;
  $('question-context').textContent = q.context || '';
  $('question-context').style.display = q.context ? 'block' : 'none';

  // Clear previous state
  $('result-pill').innerHTML = '';
  $('explanation').classList.remove('show');
  $('explanation').textContent = '';
  $('next-btn').classList.remove('show');
  $('streak-badge').classList.remove('show');

  // Build answer buttons
  const grid = $('answers-grid');
  grid.innerHTML = '';
  const letters = ['A', 'B', 'C', 'D'];

  // Shuffle options maintaining correct answer tracking
  const indices = [0,1,2,3];
  const shuffledIndices = difficulty === 'hard' ? shuffle(indices) : indices;
  let newCorrectIdx = shuffledIndices.indexOf(q.answer);

  shuffledIndices.forEach((origIdx, displayIdx) => {
    const btn = document.createElement('button');
    btn.className = 'answer-btn';
    btn.innerHTML = `
      <div class="answer-letter">${letters[displayIdx]}</div>
      <div class="answer-text">${q.options[origIdx]}</div>
    `;
    btn.addEventListener('click', () => handleAnswer(displayIdx, newCorrectIdx, q));
    grid.appendChild(btn);
  });

  // Start timer
  startTimer();
}

function getCatColor(cat) {
  const map = {
    military:'#c0392b', political:'#2e6da4', diplomatic:'#d4690e',
    economic:'#2e7d4f', social:'#7b5ea7', atrocity:'#8b0000'
  };
  return map[cat] || '#c8973a';
}

/* ── TIMER ── */
function startTimer() {
  clearInterval(timerInterval);
  timeLeft = totalTime;
  updateTimerDisplay(timeLeft);

  timerInterval = setInterval(() => {
    timeLeft--;
    updateTimerDisplay(timeLeft);
    if (timeLeft <= 0) {
      clearInterval(timerInterval);
      handleTimeout();
    }
  }, 1000);
}

function updateTimerDisplay(t) {
  $('timer-num').textContent = t;
  const progress = t / totalTime;
  const offset = CIRCUMFERENCE * (1 - progress);
  $('ring-progress').style.strokeDashoffset = offset;

  const ring = $('timer-ring');
  const bar = $('timer-bar');
  bar.style.width = (progress * 100) + '%';

  ring.classList.remove('warning', 'critical');
  bar.classList.remove('warning', 'critical');

  if (t <= 10) {
    ring.classList.add('critical');
    bar.classList.add('critical');
  } else if (t <= 20) {
    ring.classList.add('warning');
    bar.classList.add('warning');
  }
}

function handleTimeout() {
  if (answered) return;
  answered = true;
  disableAnswers();

  const q = gameQuestions[currentQ];
  const grid = $('answers-grid');
  const btns = grid.querySelectorAll('.answer-btn');
  btns[q.answer].classList.add('reveal-correct');

  $('result-pill').innerHTML = `<span class="result-timeout">⏱ Time's up — no points awarded</span>`;
  showExplanation(q.explanation);

  streak = 0;
  breakdown.push({ q: q.q.substring(0,60)+'…', correct: false, pts: 0, timeout: true });
  speedTimes.push(totalTime);

  setTimeout(() => $('next-btn').classList.add('show'), 600);
}

/* ── HANDLE ANSWER ── */
function handleAnswer(chosen, correct, q) {
  if (answered) return;
  answered = true;
  clearInterval(timerInterval);

  const elapsed = (Date.now() - questionStartTime) / 1000;
  const grid = $('answers-grid');
  const btns = grid.querySelectorAll('.answer-btn');
  disableAnswers();

  const isCorrect = chosen === correct;

  if (isCorrect) {
    btns[chosen].classList.add('correct');
    // Points: base 500 + up to 500 for speed
    const speedBonus = Math.round(Math.max(0, (totalTime - elapsed) / totalTime) * 500);
    const pts = 500 + speedBonus;
    score += pts;
    streak++;
    correctCount++;
    bestStreak = Math.max(bestStreak, streak);
    speedTimes.push(elapsed);
    $('score-live').textContent = score + ' pts';
    breakdown.push({ q: q.q.substring(0,60)+'…', correct: true, pts, elapsed: Math.round(elapsed) });

    $('result-pill').innerHTML = `
      <span class="result-correct">✓ Correct!</span>
      <span class="points-pill">+${pts} pts</span>
    `;
    showScoreAnim(`+${pts}`, btns[chosen]);

    // Streak badge
    if (streak >= 3) {
      $('streak-text').textContent = streak + ' in a row!';
      $('streak-badge').classList.add('show');
    }
  } else {
    btns[chosen].classList.add('wrong');
    btns[correct].classList.add('reveal-correct');
    streak = 0;
    speedTimes.push(totalTime);
    breakdown.push({ q: q.q.substring(0,60)+'…', correct: false, pts: 0, elapsed: Math.round(elapsed) });

    $('result-pill').innerHTML = `<span class="result-wrong">✗ Incorrect</span>`;
  }

  showExplanation(q.explanation);
  setTimeout(() => $('next-btn').classList.add('show'), 800);
}

function disableAnswers() {
  document.querySelectorAll('.answer-btn').forEach(b => b.disabled = true);
}

function showExplanation(text) {
  const el = $('explanation');
  el.innerHTML = '<strong>Historical Context:</strong> ' + text;
  el.classList.add('show');
}

function showScoreAnim(text, targetEl) {
  const rect = targetEl.getBoundingClientRect();
  const el = document.createElement('div');
  el.className = 'score-anim';
  el.textContent = text;
  el.style.left = rect.left + rect.width / 2 + 'px';
  el.style.top = rect.top + 'px';
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 1300);
}

/* ── NEXT ── */
$('next-btn').addEventListener('click', () => {
  currentQ++;
  if (currentQ >= gameQuestions.length) {
    showResults();
  } else {
    loadQuestion();
  }
});

/* ── RESULTS ── */
function showResults() {
  clearInterval(timerInterval);
  showScreen('result');

  const total = gameQuestions.length;
  const pct = Math.round((correctCount / total) * 100);
  const avgSpeed = speedTimes.length
    ? Math.round(speedTimes.reduce((a,b)=>a+b,0) / speedTimes.length)
    : 0;

  $('result-score').textContent = score;
  $('result-correct').textContent = correctCount;
  $('result-wrong').textContent = total - correctCount;
  $('result-streak').textContent = bestStreak;
  $('result-avg').textContent = avgSpeed + 's';

  // Rank
  let rank, subtitle;
  if (pct >= 95) { rank = '🎖 Supreme Commander'; subtitle = 'An extraordinary command of wartime history.'; }
  else if (pct >= 80) { rank = '⭐ Field Marshal'; subtitle = 'A masterful grasp of the conflict.'; }
  else if (pct >= 65) { rank = '🏅 Senior Officer'; subtitle = 'A solid and commendable performance.'; }
  else if (pct >= 50) { rank = '📋 Staff Officer'; subtitle = 'A workmanlike showing — room to advance.'; }
  else if (pct >= 35) { rank = '🗺 Intelligence Analyst'; subtitle = 'More time in the archives is recommended.'; }
  else { rank = '📰 War Correspondent'; subtitle = 'History rewards those who revisit it.'; }

  let title;
  if (pct >= 80) title = 'Excellent Work';
  else if (pct >= 60) title = 'Well Done';
  else if (pct >= 40) title = 'Keep Studying';
  else title = 'History Awaits';

  $('result-title').textContent = title;
  $('result-subtitle').textContent = subtitle;
  $('result-rank').textContent = rank;

  // Breakdown
  const list = $('breakdown-list');
  list.innerHTML = '';
  breakdown.forEach((item, i) => {
    const div = document.createElement('div');
    div.className = 'breakdown-item';
    div.innerHTML = `
      <span class="breakdown-icon">${item.correct ? '✓' : item.timeout ? '⏱' : '✗'}</span>
      <span class="breakdown-q">Q${i+1}: <strong>${item.q}</strong></span>
      <span class="breakdown-pts">${item.correct ? '+'+item.pts : '—'}</span>
    `;
    list.appendChild(div);
  });

  // Animate score counting
  let displayed = 0;
  const target = score;
  const step = Math.ceil(target / 60);
  const counter = setInterval(() => {
    displayed = Math.min(displayed + step, target);
    $('result-score').textContent = displayed;
    if (displayed >= target) clearInterval(counter);
  }, 24);
}

$('play-again-btn').addEventListener('click', () => {
  showScreen('splash');
});

/* Ring init */
$('ring-progress').style.strokeDasharray = CIRCUMFERENCE;
$('ring-progress').style.strokeDashoffset = 0;
</script>

